# Copy to sourceCode/apps/api/.env for local development. Do not commit real values.
MONGO_URI=mongodb://localhost:27017/claim_triage
JWT_SECRET=change-me
PORT=4000
ANTHROPIC_API_KEY=
TEMPLATE_FOLDER_PATH=../../../Template
VENDOR_DOC_UPLOAD_PATH=./vendor_doc_uploads
# true = on startup, load ./seed/ClaimDB into the database if it has no collections yet
SEED_ON_EMPTY=false

# Frontend (repo-root .env). Empty VITE_API_URL = same origin as the site.
VITE_GRAPHQL_URL=http://localhost:4000/graphql
VITE_API_URL=http://localhost:4000
