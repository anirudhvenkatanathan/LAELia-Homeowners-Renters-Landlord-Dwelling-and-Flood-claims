    "ruleId": "f27e2c78-9efc-45d3-aa96-d5082cc80008",
    "name": "Conflict Check",
    "category": "Compliance",
    "description": "Prevents vendor assignment when conflict of interest is detected.",
    "status": "Active",
    "conditions": "IF vendor.conflict_flag = TRUE THEN exclude vendor",
    "createdBy": "Admin",
